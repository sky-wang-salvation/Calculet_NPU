{
  "name": "calculet-npu-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["plugins/npu-bridge"],
  "scripts": {
    "build": "npm run build --workspace dsh-calculet-npu",
    "typecheck": "npm run typecheck --workspace dsh-calculet-npu",
    "test": "npm run test --workspace dsh-calculet-npu",
    "harness": "node scripts/launch.mjs",
    "harness:config": "node scripts/launch.mjs --dump-config",
    "harness:test-service": "node scripts/test-service.mjs",
    "test:integration": "node --test scripts/test-service.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.56.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.9.0 <25"
  }
}
